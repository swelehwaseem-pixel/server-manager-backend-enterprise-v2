# Core
SECRET_KEY=<64-char-hex-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_VERSION=2.0.0
CORS_ORIGINS=https://your-frontend-domain.com
WEB_CONCURRENCY=2

# PostgreSQL
POSTGRES_DB=servermanager
POSTGRES_USER=servermanager
POSTGRES_PASSWORD=<unique-64-char-hex-password>
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# First admin
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=<different-64-char-hex-password>

# UI / Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=<different-64-char-hex-password>

HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
LETSENCRYPT_DIR=/etc/letsencrypt
