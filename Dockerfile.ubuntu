# ==============================================================
# STAGE 1: Builder (Compiles dependencies)
# ==============================================================
FROM python:3.11.11-slim AS builder
WORKDIR /build

# Install build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt


# ==============================================================
# STAGE 2: Production Runner
# ==============================================================
FROM python:3.11.11-slim AS runner

# --------------------------------------------------------------
# 1. Create Non-Root User & Add to sudo group
# --------------------------------------------------------------
RUN addgroup --gid 1000 appuser && \
    adduser --uid 1000 --gid 1000 --disabled-password --gecos "" appuser && \
    adduser appuser systemd-journal && \
    adduser appuser sudo

# --------------------------------------------------------------
# 2. Install System Dependencies (sudo, systemd, MSSQL ODBC)
# --------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    systemd \
    curl \
    gnupg \
    unixodbc \
    unixodbc-dev \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /usr/share/keyrings/microsoft-prod.gpg \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/${ID}/${VERSION_ID}/prod ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 mssql-tools18 \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------------
# 3. Allow appuser to run sudo without password (Required for Oracle subprocess calls)
# --------------------------------------------------------------
RUN echo "appuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

WORKDIR /app

# --------------------------------------------------------------
# 4. Copy Application Code & Dependencies
# --------------------------------------------------------------
COPY --from=builder /root/.local /home/appuser/.local
COPY ./app ./app

# --------------------------------------------------------------
# 5. Set Environment Variables
# --------------------------------------------------------------
ENV PATH=/home/appuser/.local/bin:/opt/mssql-tools18/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV TZ=UTC

# --------------------------------------------------------------
# 6. Set Ownership & Switch to Non-Root User
# --------------------------------------------------------------
RUN chown -R appuser:appuser /app
USER appuser

# --------------------------------------------------------------
# 7. Healthcheck & Startup Command
# --------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

EXPOSE 8000

CMD ["sh", "-c", "gunicorn app.main:app \
    -w ${WEB_CONCURRENCY:-2} \
    -k uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    --graceful-timeout 30"]
